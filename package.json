{
  "name": "forgewright",
  "version": "0.0.0",
  "private": true,
  "description": "One TypeScript API for many git forges (GitHub, GitLab), modeled on packit/ogr and generated from each forge's OpenAPI description.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "specs:update": "tsx scripts/update-specs.ts",
    "specs:bump": "tsx scripts/bump-spec-pins.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "all": "npm run fix && npm run typecheck && npm test && npm run build",
    "coverage": "vitest run --coverage",
    "check:browser": "esbuild src/index.ts --bundle --platform=browser --format=esm --log-level=warning --outfile=/dev/null",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "author": "Ben Balter",
  "license": "MIT",
  "dependencies": {
    "git-url-parse": "16.1.0",
    "http-link-header": "1.1.4",
    "ky": "2.1.0",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/git-url-parse": "16.0.2",
    "@types/http-link-header": "1.0.7",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "msw": "2.15.0",
    "openapi-backend": "5.21.2",
    "openapi-format": "1.33.7",
    "openapi-msw": "2.0.0",
    "openapi-sampler": "1.7.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benbalter/forgewright.git"
  }
}
